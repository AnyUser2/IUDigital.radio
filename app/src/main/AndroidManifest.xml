<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RF-03: permisos declarados. CAMERA se solicita en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Necesario para el streaming de las emisoras -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- La cámara no es obligatoria para instalar la app (tablets/emuladores) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IUDigitalRadio">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.IUDigitalRadio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <!-- Visibilidad de paquetes (Android 11+) para abrir la cámara nativa -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

</manifest>
